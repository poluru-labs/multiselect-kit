{
  "name": "@poluru-labs/multiselect-kit",
  "version": "1.0.0",
  "description": "Accessible, lightweight, and customizable multi-select component kit for modern web apps.",
  "author": {
    "name": "Subrahmanyam Poluru",
    "email": "mail.polurus@gmail.com",
    "url": "https://polurus.com"
  },
  "contributors": [
    {
      "name": "Subrahmanyam Poluru",
      "email": "mail.polurus@gmail.com",
      "url": "https://www.linkedin.com/in/polurus/"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/poluru-labs/multiselect-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poluru-labs/multiselect-kit.git"
  },
  "bugs": {
    "url": "https://github.com/poluru-labs/multiselect-kit/issues",
    "email": "mail.polurus@gmail.com"
  },
  "funding": {
    "type": "individual",
    "url": "https://polurus.com"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "AUTHORS",
    "NOTICE",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6011",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist storybook-static coverage *.tgz",
    "verify": "npm run typecheck && npm test && npm run build",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run verify && npm run pack:check"
  },
  "keywords": [
    "multiselect",
    "multi-select",
    "select",
    "combobox",
    "web-components",
    "custom-elements",
    "accessibility",
    "typescript",
    "esm",
    "framework-agnostic",
    "poluru-labs",
    "multiselect-kit"
  ],
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/web-components": "^8.6.14",
    "@storybook/web-components-vite": "^8.6.14",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^18.0.1",
    "storybook": "^8.6.14",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
